@page
@model RegisterModel
@{
	ViewData["Title"] = "Register";
}

<div class="auth-wrap">
	<div class="auth-card">
		<h1 class="auth-title">REGISTER</h1>
		<p class="auth-sub">One account — all your links, every click counted.</p>

		<nav class="auth-switch" aria-label="Log in or register">
			<a class="auth-tab" asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">LOG IN</a>
			<span class="auth-tab is-active" aria-current="page">REGISTER</span>
		</nav>

		@if (Model.ExternalLogins.Count > 0)
		{
			<form asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="auth-external">
				@foreach (var provider in Model.ExternalLogins)
				{
					<button type="submit" class="btn-auth btn-auth-ghost" name="provider" value="@provider.Name">
						CONTINUE WITH @provider.DisplayName!.ToUpperInvariant()
					</button>
				}
			</form>
			<div class="auth-divider"><span>OR</span></div>
		}

		<form id="registerForm" method="post" class="auth-form">
			<div asp-validation-summary="ModelOnly" class="auth-error" role="alert"></div>

			<div class="field">
				<label class="field-label" asp-for="Input.Email">EMAIL</label>
				<input asp-for="Input.Email" class="input-min" autocomplete="username" placeholder="you@example.com" autofocus />
				<span asp-validation-for="Input.Email" class="auth-error"></span>
			</div>

			<div class="field">
				<label class="field-label" asp-for="Input.Password">PASSWORD</label>
				<div class="pass-wrap">
					<input asp-for="Input.Password" class="input-min" autocomplete="new-password" placeholder="••••••••" />
					<button type="button" class="pass-toggle" data-target="Input_Password" aria-label="Show password" aria-pressed="false">
						<svg class="eye" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z"/><circle cx="12" cy="12" r="2.6"/></svg>
						<svg class="eye-off" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z"/><circle cx="12" cy="12" r="2.6"/><line x1="4" y1="20" x2="20" y2="4"/></svg>
					</button>
				</div>
				<span asp-validation-for="Input.Password" class="auth-error"></span>
			</div>

			<div class="field">
				<label class="field-label" asp-for="Input.ConfirmPassword">CONFIRM PASSWORD</label>
				<div class="pass-wrap">
					<input asp-for="Input.ConfirmPassword" class="input-min" autocomplete="new-password" placeholder="••••••••" />
					<button type="button" class="pass-toggle" data-target="Input_ConfirmPassword" aria-label="Show password" aria-pressed="false">
						<svg class="eye" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z"/><circle cx="12" cy="12" r="2.6"/></svg>
						<svg class="eye-off" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z"/><circle cx="12" cy="12" r="2.6"/><line x1="4" y1="20" x2="20" y2="4"/></svg>
					</button>
				</div>
				<span asp-validation-for="Input.ConfirmPassword" class="auth-error"></span>
			</div>

			<button id="registerSubmit" type="submit" class="btn-auth btn-auth-solid">REGISTER</button>
		</form>

	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
	<script src="~/js/auth.js" asp-append-version="true"></script>
}
